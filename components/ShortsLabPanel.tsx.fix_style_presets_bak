            // 留덈쭏???붿껌: ?대?吏/?대뜑 ?먮룞 ?뺣━ 鍮꾪솢?깊솕 (?섎룞 ??젣 ?꾧퉴吏 蹂댁〈)

            // 5?④퀎: 罹먮┃??留??앹꽦
            const characterIds = characterList.map(item => item.id);
            let autoCharacterMap = buildAutoCharacterMap(characterIds, aiTargetAge, false);

