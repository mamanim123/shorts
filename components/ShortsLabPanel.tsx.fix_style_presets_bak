const mapAliasToSlot = (value: string, defaultGender: 'female' | 'male'): string => {
    const lower = value.toLowerCase();
    if (/(二쇱씤怨????닿?|narrator|protagonist|character1|character_1)/i.test(lower)) {
        return defaultGender === 'male' ? 'ManA' : 'WomanA';
